      "unit": "stick"
    },
    {
      "item": "applesauce",
      "quantity": 1,
      "unit": "cup"
    },
    {
      "item": "vanilla extract",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "item": "salt",
      "quantity": 0.5,
      "unit": "tsp"
    },
    {
      "item": "ground cinnamon",
      "quantity": 1,
      "unit": "tsp"
    },
    {
      "item": "raisins (optional)",
      "quantity": null,
      "unit": "to taste"
    },
    {
      "item": "apricots (optional, chopped)",
      "quantity": null,
      "unit": "to taste"
    }
  ],
  "steps": [
    "Preheat oven to 350°F.",
    "Cook noodles according to package directions and drain.",
    "Melt margarine.",
    "Beat eggs in a large bowl.",
