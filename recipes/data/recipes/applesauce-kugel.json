  "name": "Apple sauce Kugel",
  "description": "A baked noodle-and-apple casserole-style dessert made with eggs, applesauce, cinnamon, and optional raisins.",
  "source": "Linda",
  "yield": {
    "amount": 1,
    "unit": "9x13 pan"
